{
  "name": "ditto-settings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run locales:check && tsc --noEmit && vite build",
    "locales:check": "node scripts/check-locales.mjs",
    "preview": "vite preview",
    "visual:check": "node scripts/visual-check.mjs",
    "tokens": "node ../../../scripts/generate-tokens.mjs",
    "tokens:check": "node ../../../scripts/generate-tokens.mjs --check"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.345",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
